# ============================================
# DSE Baselines — .gitignore
# ============================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ---- Virtual Environments ----
.venv/
venv/
ENV/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDE ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ---- PyG Cached Graphs (auto-regenerated) ----
# These are regenerated from raw data + masks at runtime
*/processed/*.pt
DSGAT/data_WS/processed/
DSGAT/data_ICS/processed/
DSGAT/data_750+9/processed/
A-3Net-master/warm-scence_data/*.pt
A-3Net-master/cold-scence_data/*.pt

# ---- HSTrans generated substructure files ----
# Regenerated by identify_sub() at runtime
HSTrans/HSTrans/data/sub/
HSTrans/HSTrans_original/HSTrans/data/sub/

# ---- HSTrans duplicate venv copy (848MB!) ----
HSTrans/HSTrans/

# ---- Model checkpoints & pretrained weights ----
SDPred/data/my_model.dat
*.pth
*.model

# ---- Training results & predictions (generated at runtime) ----
results/
*/result_WS/
*/result_ICS/
*/predictResult/

# ---- Submodule .git directories ----
# Each cloned repo has its own .git (>600MB total)
# Remove these before pushing to your own repo
SDPred/.git
MSSF/.git
MGPred/.git
A-3Net-master/.git
DSGAT/.git
MVSL-DSF/.git
AGRL-DSE/.git
Side-effect-Frequencies/.git
HSTrans/.git

# ---- Large Excel plot files (A3Net) ----
A-3Net-master/plots/pred.xlsx
A-3Net-master/plots/truth.xlsx

# ---- A3Net LFS pointer files (won't work without LFS setup) ----
# These are Git LFS pointers, actual data is in shared_data/
# Uncomment if you want to exclude them:
# A-3Net-master/data/*.mat
# A-3Net-master/data/*.csv
# A-3Net-master/data/*.txt
